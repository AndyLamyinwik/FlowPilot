# Copy to .env in the repository root. Never commit your local .env.
# Backend settings, Vite and the local production frontend npm start load this file.

FLOWPILOT_LOG_LEVEL=INFO
# AI foundation only: no real model adapter, AI node or public AI endpoint.
# Setting true does not register providers or call models; V1 needs no AI keys.
FLOWPILOT_AI_ENABLED=false
# Inbound Host names, shared by the backend and production frontend.
# Exact names only: no wildcard, URL, port or credentials. Keep backend for Compose proxy.
FLOWPILOT_ALLOWED_HOSTS='["localhost","127.0.0.1","[::1]","backend"]'

# Single backend process; disable job dispatch in tests or maintenance.
FLOWPILOT_SCHEDULER_ENABLED=true
FLOWPILOT_SCHEDULER_WORKERS=4
# History excludes node outputs by default. Opt-in redaction cannot detect all secrets.
FLOWPILOT_STORE_EXECUTION_OUTPUTS=false
FLOWPILOT_HISTORY_RETENTION_DAYS=30
FLOWPILOT_HISTORY_MAX_RECORD_BYTES=262144
# Synchronous execution limits. Byte budget covers compact UTF-8 node outputs.
FLOWPILOT_EXECUTION_MAX_NODES=256
FLOWPILOT_EXECUTION_MAX_OUTPUT_BYTES=1048576
# HTTP/Webhook destinations are disabled until explicit exact hosts are allowed.
# Example for the documented public workflows: '["httpbin.org"]'
FLOWPILOT_HTTP_ALLOWED_HOSTS=[]
FLOWPILOT_HTTP_ALLOW_INSECURE=false
FLOWPILOT_HTTP_MAX_REQUEST_BYTES=65536
FLOWPILOT_HTTP_MAX_RESPONSE_BYTES=262144
# Explicit browser origins, expressed as a JSON array. No wildcard by default.
FLOWPILOT_CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'

# Optional SQLite override for local development (relative to backend/).
# By default, the backend resolves the repository's data/flowpilot.db.
# Compose always uses /app/data/flowpilot.db, mounted from ./data.
# FLOWPILOT_DATABASE_PATH=../data/flowpilot.db

# Public client configuration: never place secrets in VITE_* variables.
# The base includes /api; the health client appends /health.
# Production builds bake this value into the bundle; rebuild after changing it.
# Compose forwards this as a build argument. Keep /api for the same-origin proxy.
VITE_API_BASE_URL=/api
# Server-only API proxy target for local Vite or the production frontend server.
# Compose fixes its internal target to http://backend:8000; the browser uses /api.
API_PROXY_TARGET=http://127.0.0.1:8000
# Optional native production frontend listener. Defaults stay loopback-only.
# The container listens on 0.0.0.0 internally; Compose publishes only to 127.0.0.1.
# FLOWPILOT_FRONTEND_HOST=127.0.0.1
# FLOWPILOT_FRONTEND_PORT=5173

